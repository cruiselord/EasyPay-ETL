# ── NIBSS ETL configuration ─────────────────────────────────────────
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# The real `.env` is gitignored — never commit it.

# ── Email (Microsoft 365 / Outlook SMTP) ────────────────────────────
EMAIL_USER="you@yourorg.com"          # sender address (your Outlook mailbox)
EMAIL_PASSWORD="your-app-password"    # Microsoft app password — NOT your normal password
TEAM_EMAIL="team@yourorg.com"         # workbook email recipients (comma-separated)
MD_EMAIL="md@yourorg.com"             # OPTIONAL: exec-summary recipient (empty = skip MD email)

# ── NIBSS Thin Client login (used by fetcher.py) ───────────────────
NIBSS_USER="your-nibss-username"
NIBSS_PASSWORD="your-nibss-password"

# ── Optional: daily scheduler ───────────────────────────────────────
# NIBSS_RUN_AFTER="07:00"             # earliest time auto_run.sh may run (HH:MM, 24h)
